generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum AppointmentStatus {
  PENDIENTE
  ASISTIO
  NO_ASISTIO
  CANCELADO
}

enum VademecumItemType {
  MEDICAMENTO
  INSUMO
  KIT
  OTRO
}

model User {
  id           String        @id @default(cuid())
  nombre       String
  apellido     String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  totpSecret   String?
  totpEnabled  Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  appointments Appointment[]
  attendances  Attendance[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ip         String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Patient {
  id           String        @id @default(cuid())
  nombre       String
  apellido     String
  dni          String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  attendances  Attendance[]
  cases        PatientCase[]

  @@index([apellido])
  @@index([dni])
}

model PatientCase {
  id              String   @id @default(cuid())
  patientId       String
  art             String
  numeroSiniestro String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([patientId, createdAt])
}

model Art {
  id        String                @id @default(cuid())
  nombre    String                @unique
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  coverages ArtPharmacyCoverage[]
}

model Pharmacy {
  id        String           @id @default(cuid())
  nombre    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  branches  PharmacyBranch[]

  @@unique([nombre])
  @@index([nombre])
}

model PharmacyBranch {
  id         String                @id @default(cuid())
  pharmacyId String
  direccion  String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  pharmacy   Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  coverages  ArtPharmacyCoverage[]

  @@unique([pharmacyId, direccion])
  @@index([direccion])
}

model ArtPharmacyCoverage {
  id               String         @id @default(cuid())
  artId            String
  pharmacyBranchId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  art              Art            @relation(fields: [artId], references: [id], onDelete: Cascade)
  pharmacyBranch   PharmacyBranch @relation(fields: [pharmacyBranchId], references: [id], onDelete: Cascade)

  @@unique([artId, pharmacyBranchId])
  @@index([artId])
  @@index([pharmacyBranchId])
}

model Appointment {
  id            String            @id @default(cuid())
  userId        String
  patientId     String
  fecha         DateTime
  hora          String
  estado        AppointmentStatus @default(PENDIENTE)
  observaciones String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  cancelledAt   DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  attendances   Attendance[]

  @@index([userId])
  @@index([userId, fecha])
  @@index([patientId])
  @@index([fecha])
  @@index([fecha, hora])
}

model Attendance {
  id            String       @id @default(cuid())
  userId        String
  patientId     String
  appointmentId String?
  fechaAtencion DateTime
  observaciones String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, fechaAtencion])
  @@index([patientId])
  @@index([appointmentId])
  @@index([fechaAtencion])
}

model VademecumItem {
  id             String            @id @default(cuid())
  type           VademecumItemType @default(MEDICAMENTO)
  drug           String?
  commercialName String
  dose           String?
  lab            String?
  presentation   String?
  description    String?
  components     String?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([commercialName])
  @@index([drug])
  @@index([lab])
  @@index([type, isActive])
}
